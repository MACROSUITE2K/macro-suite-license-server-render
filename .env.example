# Copy to .env and replace ALL secret values before running.
APP_NAME=License Server
ENVIRONMENT=production
DATABASE_URL=sqlite:///./license.db
SECURE_STARTUP_ENFORCED=true

ADMIN_TOKEN=<generate-64+-char-random-token>
LICENSE_KEY_SECRET=<generate-64+-char-random-secret>
ACTIVATION_TOKEN_SECRET=<generate-64+-char-random-secret>
JWT_SECRET=<generate-64+-char-random-secret>
SERVER_SECRET=<generate-64+-char-random-secret>
API_SECRET=<generate-64+-char-random-secret>
HMAC_KEY=<generate-64+-char-random-secret>
LICENSE_SIGNING_KEY=<generate-64+-char-random-secret>
CLIENT_SHARED_SECRET=<generate-64+-char-random-secret>

ACTIVATION_TOKEN_TTL_MINUTES=30
LAUNCH_TOKEN_TTL_SECONDS=300
ACTIVATION_TOKEN_ISSUER=license-server

CHALLENGE_TTL_SECONDS=120
CHALLENGE_TIMESTAMP_TTL_SECONDS=90

HEARTBEAT_INTERVAL_SECONDS=15

REQUIRE_HTTPS=true
ALLOW_HTTP_LOCALHOST=false
PROXY_PROTO_HEADER=x-forwarded-proto

REQUIRE_CLIENT_SIGNATURES=true
CLIENT_SIGNATURE_TTL_SECONDS=120

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_ACTIVATE_PER_WINDOW=20
RATE_LIMIT_VALIDATE_PER_WINDOW=120
RATE_LIMIT_HEARTBEAT_PER_WINDOW=120
RATE_LIMIT_CHALLENGE_PER_WINDOW=40
RATE_LIMIT_SECURITY_EVENT_PER_WINDOW=30

PER_LICENSE_RATE_LIMIT_WINDOW_SECONDS=60
PER_LICENSE_ACTIVATE_PER_WINDOW=8
PER_LICENSE_VALIDATE_PER_WINDOW=40

AUTO_REVOKE_ON_ABUSE=true
MAX_ACTIVATION_FAILURES_PER_HOUR=10
MAX_HEARTBEAT_FAILURES_PER_ACTIVATION=6
MAX_IP_CHANGES_PER_ACTIVATION_PER_DAY=4
MAX_TAMPER_EVENTS_PER_DAY=1

# Client runtime settings
LICENSE_SERVER_URL=https://YOUR_REAL_LICENSE_API_URL
PINNED_PUBLIC_KEY_SHA256=<server-public-key-spki-sha256-hex>
DEVICE_HMAC_KEY=<same-value-as-HMAC_KEY>
REQUIRE_CODE_SIGNATURE=true
EXPECTED_SELF_SHA256=<optional-self-file-sha256>
APP_VERSION=1.0.0
REQUEST_TIMEOUT_SECONDS=15
